{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Easy FPS Editor Script",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#procedures"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#fsmStates"
    },
    {
      "include": "#fsmCommands"
    },
    {
      "include": "#commands"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.efpss",
          "match": "//.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.efpss",
          "match": "\\b(if|else|end|procedure|call|return)\\b"
        },
        {
          "name": "keyword.control.fsm.efpss",
          "match": "\\b(image|sound|state|frame|frameset)\\b"
        }
      ]
    },
    "procedures": {
      "patterns": [
        {
          "name": "entity.name.function.definition.efpss",
          "match": "(?<=procedure\\s+)\\w+"
        },
        {
          "name": "entity.name.function.call.efpss",
          "match": "(?<=call\\s+)\\w+"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.language.global.efpss",
          "match": "\\$global\\.[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*(?:\\[[^\\]]+\\])*(?:[XYZ])?"
        },
        {
          "name": "variable.language.map.efpss",
          "match": "\\$map\\.[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*(?:\\[[^\\]]+\\])*(?:[XYZ])?"
        },
        {
          "name": "variable.other.dollar.efpss",
          "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*(?:\\[[^\\]]+\\])*(?:[XYZ])?"
        },
        {
          "name": "variable.other.local.efpss",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?!\\s*\\()"
        }
      ]
    },
    "commands": {
      "patterns": [
        {
          "name": "support.function.builtin.efpss",
          "match": "\\b(auto|timeout|pause|halt|keeptrigger|map|next|return|quickreturn|goto|start|player|heal|hurt|teleport|move|rotation|retro|turn|check|speed|zoom|velocity|position|heldweapon|mag|ammo|entity|delete|spawnat|spawnatpos|door|open|close|lock|unlock|light|create|status|offset|flashlight|ambient|sun|give|take|weapon|key|cursor|shader|set|texture|bool|int|float|vec2|vec3|vec4|game|save|load|slot|quick|gravity|hud|image|autoscale|variable|text|font|vn|preload|show|bg|hide|play|stop|music|video|sound|button|label|front|back|bind|unbind|resolution)\\b"
        }
      ]
    },
    "fsmCommands": {
      "patterns": [
        {
          "name": "storage.type.fsm.action.efpss",
          "match": "\\b(NONE|READY|SOUND|SOUNDANDATTACK|ATTACK|PLAYERSPEED|PARTICLES|CUSTOMPARTICLE|PLAYERDISTANCE|PLAYERVISIBLE|SETVAR|MODELTEXTURE|SPAWN|HUDIMG|CAMSPEED|CHECKPOS|SETYAW|ADDYAW|ROTMODE|HEAL|HURT|SETHP|EXPLOSION|PROJECTILE|INCREMENT|DECREMENT|MULTIPLY|DIVIDE|MODULO|CLAMP|JUMPIFEQUALS|JUMPIFNEQUALS|JUMPIFGEQUALS|JUMPIFLEQUALS|JUMPIFGREATER|JUMPIFLESS|JUMPIFHPLESS|JUMPIFLESSAMMO|JUMPIFNOAMMO|JUMPIFNOAMMOTOTAL|GIVEAMMO|TAKEAMMO|SETAMMO|RELOAD|MUZZLEFLASH|SETSTAT|ZOOM)\\b"
        }
      ]
    },
    "fsmStates": {
      "patterns": [
        {
          "name": "constant.language.state.efpss",
          "match": "\\b(IDLE|DEATH|DEAD|DRAW|HOLSTER|ATTACK|ALTATTACK|RELOAD|SEE|CHASE|FLEE|HURT|XDEATH)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.efpss",
          "match": "\\b(RANDOM|SQRT|ABS|SIN|COS|TAN|ASIN|ACOS|ATAN|ATAN2|CEIL|FLOOR|ROUND|POWER|CLAMP|MIN|MAX|LASTDAMAGE|HP|MAXHP|AMMO|MAGAMMO)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.efpss",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.arithmetic.efpss",
          "match": "(\\+\\+|--|\\+=|-=|\\*=|/=|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.assignment.efpss",
          "match": "="
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.efpss",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.efpss",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.efpss",
              "match": "\\\\."
            },
            {
              "name": "variable.other.efpss",
              "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*"
            }
          ]
        }
      ]
    }
  },
  "scopeName": "source.efpss"
}
